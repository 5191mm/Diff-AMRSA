# Diff-AMRSA path and runtime configuration.
# Edit these paths once, then run scripts/run_diff_amrsa_pipeline.sh.

export DIFF_AMRSA_RAW_DIR=/autodl-fs/data/diff_amrsa_raw
export DIFF_AMRSA_PROCESSED_DIR=/autodl-fs/data/diff_amrsa_processed
export DIFF_AMRSA_PROCESSED_CSV=${DIFF_AMRSA_PROCESSED_DIR}/processed_drug_mic_dataset.csv
export DIFF_AMRSA_SCHEME_A_DIR=${DIFF_AMRSA_PROCESSED_DIR}/scheme_a
export DIFF_AMRSA_SCHEME_A_CSV=${DIFF_AMRSA_SCHEME_A_DIR}/processed_drug_mic_dataset_schemeA.csv
export DIFF_AMRSA_DATASET_ROOT=/autodl-fs/data/custom_mrsa_schemeA_fixed_30_10
export DIFF_AMRSA_GEOM_DATASET_ROOT=/autodl-fs/data/drugs_data/geom_processed
export DIFF_AMRSA_RESULTS_DIR=./results
export DIFF_AMRSA_GENERATED_DIR=./generated

export DIFF_AMRSA_PRETRAINED_CKPT=/autodl-fs/data/megalodon_large_diffusion.ckpt
export DIFF_AMRSA_FINETUNED_CKPT=${DIFF_AMRSA_RESULTS_DIR}/diff_amrsa_finetune/checkpoints/last.ckpt
export DIFF_AMRSA_PREDICTOR=${DIFF_AMRSA_DATASET_ROOT}/processed/mrsa_activity_predictor_schemeA.joblib

export DIFF_AMRSA_NUM_CANDIDATES=30
export DIFF_AMRSA_SELECT_CONFORMERS=10
export DIFF_AMRSA_NUM_WORKERS=16
export DIFF_AMRSA_RDKIT_THREADS=1
export DIFF_AMRSA_MOLECULE_TIMEOUT_SEC=900

export DIFF_AMRSA_BATCH_SIZE=16
export DIFF_AMRSA_EPOCHS=30
export DIFF_AMRSA_N_GRAPHS=1000
export DIFF_AMRSA_SAMPLE_BATCH_SIZE=100
export DIFF_AMRSA_TIMESTEPS=250
export DIFF_AMRSA_TOP_K=200
